# Copy to .env.local for local development, or set these in Vercel / Netlify
# (Project → Settings → Environment Variables). Leave them unset to run the
# app in single-device mode with data stored only in the browser.
#
# Both values are in Supabase: Project Settings → API.
# The anon key is designed to be public; access is controlled by the database rules.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
